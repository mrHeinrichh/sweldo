# Leave both blank to run the zero-setup XLM demo.
# For test USDC, set both values and ensure the employer owns the asset.
VITE_ASSET_CODE=
VITE_ASSET_ISSUER=

# Optional controlled PHPT issuer for test-USDC to PHPT claim-and-convert.
# Use npm run week4:configure to load the verified local Testnet asset pair.
VITE_PHPT_ISSUER=

# Soroban Payroll Registry contract on Stellar Testnet.
VITE_PAYROLL_REGISTRY_CONTRACT_ID=CDAGOOIBW7EUHHHOXXNMFT23YWPE5F352HGKJOFCURU6S2KDG3XQLHUC

# Pair the Varial mobile app (QR code / deep link) over WalletConnect.
# Get a free project ID at https://dashboard.reown.com and add this site's domain.
VITE_WALLETCONNECT_PROJECT_ID=
