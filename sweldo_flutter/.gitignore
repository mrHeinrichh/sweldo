# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local-only dart-define files (e.g. a WalletConnect project ID)
config/*.local.json

# Android upload signing credentials
/android/key.properties
*.jks

# Generated from the shared website wallet adapter; retain the bridge page.
/assets/wallet_kit/*
!/assets/wallet_kit/index.html

# Duplicate copies of local Flutter-generated state.
/.flutter-plugins-dependencies [0-9]*
/ios/Flutter/Generated [0-9]*.xcconfig
/ios/Flutter/flutter_export_environment [0-9]*.sh
