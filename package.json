{
  "name": "stellar-hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "week1:setup": "node scripts/week1-testnet.mjs setup",
    "week1:demo": "node scripts/week1-testnet.mjs demo",
    "week1:verify": "node scripts/week1-testnet.mjs verify",
    "week1:all": "node scripts/week1-testnet.mjs all",
    "week2:test": "node --experimental-strip-types --test scripts/week2-claim-convert.test.mjs",
    "week2:configure": "node scripts/week2-demo.mjs configure",
    "week2:prepare": "node scripts/week2-demo.mjs prepare",
    "week2:verify": "node scripts/week2-demo.mjs verify",
    "week2:dev": "vite --mode week2 --host 127.0.0.1",
    "week3:test": "node --experimental-strip-types --test scripts/week3-payroll-state.test.mjs",
    "week3:inspect": "node --experimental-strip-types scripts/week3-demo.mjs",
    "week3:dev": "vite --mode week3 --host 127.0.0.1",
    "week4:test": "node --experimental-strip-types --test scripts/week4-signing.test.mjs scripts/week4-wallets.test.mjs scripts/week4-funding-errors.test.mjs scripts/week4-faucet.test.mjs scripts/week4-assets.test.mjs scripts/week4-funding-ui.test.mjs",
    "week4:configure": "node --experimental-strip-types scripts/week4-demo.mjs configure",
    "week4:verify": "node --experimental-strip-types scripts/week4-demo.mjs verify",
    "week4:dev": "vite --mode week4 --host 127.0.0.1",
    "flutter:wallet-kit": "node scripts/build-flutter-wallet-kit.mjs",
    "flutter:configure": "node scripts/configure-flutter-testnet.mjs",
    "contract:build": "PATH=/opt/homebrew/opt/rustup/bin:$PATH stellar contract build",
    "contract:test": "PATH=/opt/homebrew/opt/rustup/bin:$PATH cargo test -p sweldo_payroll_registry"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.0.1",
    "@walletconnect/sign-client": "^2.25.0",
    "@walletconnect/types": "^2.25.0",
    "@walletconnect/utils": "^2.25.0",
    "lucide-react": "^1.24.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
